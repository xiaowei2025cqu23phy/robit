# ─────────────────────────────────────────────
# xiaoyue 配置模板（复制为 .env 并填入真实值）
# 所有带默认值的项可省略；.env 不提交 Git。
# ─────────────────────────────────────────────

# ── DeepSeek API 配置 ──
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ── 提示词与模型参数 ──
# 提示词默认从 core/prompts/default.txt 读取，可直接编辑该文件；
# 也可用下面的配置覆盖（文件优先于内联）：
#   SYSTEM_PROMPT_FILE=core/prompts/custom.txt
#   SYSTEM_PROMPT=你是小月，……
MODEL_TEMP=0.7          # 采样温度 0-2（不能叫 TEMP，Windows 系统保留变量）
MAX_TOKENS=1024         # 单次最大输出

# ── AI 开关（关闭后只记录+转发，不调用大模型）──
AI_ENABLED=true

# ── 信息转发接口（不止转发给 AI）──
# 每条收发消息会 POST JSON 到以下地址（逗号分隔多个）；也可放 core/hooks/*.py 本地钩子。
FORWARD_ENABLED=true
FORWARD_URLS=
FORWARD_REPLIES=true    # 是否也转发机器人自己的回复
FORWARD_TIMEOUT=5       # 单个 Webhook 超时秒数

# ── 办公模式（把「#办公 任务」交给 deepseek-harness 在电脑工作区执行）──
# 依赖：pip install deepseek-harness-sdk（较重，按需安装）
HARNESS_ENABLED=true
OFFICE_PREFIX=#办公        # 办公模式触发前缀
SWITCH_OFFICE_CMD=#办公模式  # 切换到办公模式
SWITCH_EMOTION_CMD=#情感     # 切回情感模式
MENU_CMD=#菜单              # 模式菜单（带键盘按钮）
IMAGE_CMD=#图               # 发图：#图 <URL>
ARK_TEMPLATE_ID=0          # 办公结果 Ark 卡片模板 id（0=用 markdown）
HARNESS_CWD=              # 工作区目录（留空=项目根目录）
HARNESS_SESSION_ROOT=     # 会话持久化目录（可选）
HARNESS_MODEL=deepseek-chat
HARNESS_MAX_TOKENS=0      # 0=用提供方默认
HARNESS_TIMEOUT=0         # 单次任务超时秒数，0=不限
HARNESS_REPLY_MAX=1000    # 回传结果最长字数（纯文本，超长截断）
HARNESS_MARKDOWN_MAX=3000 # 官方机器人 markdown 回传最长字数

# ── QQ 开放平台配置（官方机器人模式）──
# 在 https://q.qq.com/#/ 创建机器人后获取
BOT_APPID=你的 AppID
BOT_SECRET=你的 AppSecret
BOT_QQ_ID=你的机器人 QQ 号
SUPERUSERS=管理员 QQ 号（多个用英文逗号分隔）
